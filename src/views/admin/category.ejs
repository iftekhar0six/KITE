<%- include('../layout/header') %>

<section class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1>Category List</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Simple Tables</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<section class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div
            class="card-header d-flex justify-content-between align-items-center"
          >
            <h3 class="card-title">Category Data</h3>
            <div class="card-tools d-flex align-items-center">
              <a
                href="/admin/category/create"
                class="btn btn-sm btn-success me-3"
              >
                Add New Category
              </a>
              <div class="input-group input-group-sm" style="width: 200px">
                <input
                  type="text"
                  name="table_search"
                  class="form-control"
                  placeholder="Search"
                />
                <div class="input-group-append">
                  <button type="submit" class="btn btn-default">
                    <i class="fas fa-search"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="card-body table-responsive p-0">
            <table class="table table-hover text-nowrap">
              <thead>
                <tr>
                  <th>Category Name</th>
                  <th>Creator Name</th>
                  <th>Creator Email</th>
                  <th>Creator Id</th>
                  <th>Category Id</th>
                </tr>
              </thead>

              <tbody>
                <% if (response.listCategory && response.listCategory.length >
                0) { %> <% response.listCategory.forEach(category => { %>
                <tr>
                  <td><%= category.name %></td>
                  <td>
                    <%= category.userDetail ? `${category.userDetail.firstName}
                    ${category.userDetail.lastName}` : "N/A" %>
                  </td>
                  <td>
                    <span class="tag tag-success"
                      ><%= category.userDetail ? category.userDetail.email :
                      "N/A" %></span
                    >
                  </td>
                  <td>
                    <%= category.userDetail ? category.userDetail.id : "N/A" %>
                  </td>
                  <td><%= category._id %></td>
                  <td>
                    <!-- Delete Button -->
                    <form
                      action="/admin/category/delete/<%= category._id %>"
                      method="POST"
                      style="display: inline-block"
                    >
                      <button
                        type="submit"
                        class="btn btn-sm btn-danger"
                        onclick="return confirm('Are you sure you want to delete this category?');"
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
                <% }); %> <% } else { %>
                <tr>
                  <td colspan="6" class="text-center">No categories found.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <ul class="pagination">
            <% for (let i = 1; i <= response.totalPage; i++) { %>
            <li
              class="page-item <%= i == response.currentPage ? 'active' : '' %>"
            >
              <a
                class="page-link"
                href="?page=<%= i %>&limit=<%= response.perPage %>&searchTerm=<%= response.searchTerm %>"
                ><%= i %></a
              >
            </li>
            <% } %>
          </ul>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Category Statistics</h3>
          </div>

          <div class="card-body">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th style="width: 10px">#</th>
                  <th>Category</th>
                  <th>Count</th>
                  <th>Progress</th>
                  <th style="width: 40px">Visual</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>1.</td>
                  <td>Category created last month</td>
                  <td><%= response.createdLastMonth %></td>
                  <td>
                    <div class="progress progress-xs">
                      <div
                        class="progress-bar bg-primary"
                        style="width: <%= response.createdMonthProgress %>%"
                      ></div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-success">
                      <%= response.createdMonthProgress.toFixed(2) %> %
                    </span>
                  </td>
                </tr>

                <tr>
                  <td>2.</td>
                  <td>Category created in last year</td>
                  <td><%= response.createdLastYear %></td>
                  <td>
                    <div class="progress progress-xs">
                      <div
                        class="progress-bar bg-primary"
                        style="width: <%= response.createdYearProgress %>%"
                      ></div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-success">
                      <%= response.createdYearProgress.toFixed(2) %> %
                    </span>
                  </td>
                </tr>

                <tr>
                  <td>3.</td>
                  <td>Category deactivated last month</td>
                  <td><%= response.deactivatedLastMonth %></td>
                  <td>
                    <div class="progress progress-xs progress-striped active">
                      <div
                        class="progress-bar bg-danger"
                        style="width: <%= response.deactivatedMonthProgress %>%"
                      ></div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-warning">
                      <%= response.deactivatedMonthProgress.toFixed(2) %> %
                    </span>
                  </td>
                </tr>

                <tr>
                  <td>4.</td>
                  <td>Category deactivated last year</td>
                  <td><%= response.deactivatedLastYear %></td>
                  <td>
                    <div class="progress progress-xs progress-striped active">
                      <div
                        class="progress-bar bg-danger"
                        style="width: <%= response.deactivatedYearProgress %>%"
                      ></div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-warning">
                      <%= response.deactivatedYearProgress.toFixed(2) %> %
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../layout/footer') %>
