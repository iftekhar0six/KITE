<%- include('../../layout/header') %>

<section class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Sub Category Data</h3>
            <div class="card-tools">
              <div class="input-group input-group-sm" style="width: 150px">
                <input type="text" name="table_search" class="form-control float-right" placeholder="Search" />
                <div class="input-group-append">
                  <button type="submit" class="btn btn-default">
                    <i class="fas fa-search"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="card-body table-responsive p-0">
            <table class="table table-hover text-nowrap">
              <thead>
                <tr>
                  <th>Sub Category Name</th>
                  <th>Category Name</th>
                  <th>Creator Name</th>
                  <th>Creator Email</th>
                  <th>Actions</th>
                </tr>
              </thead>

              <tbody>
                <% if (listSubCategory.length > 0) { %> <% listSubCategory.forEach(subCategory => { %>
                <tr>
                  <td><%= subCategory?.name || 'N/A' %></td>
                  <td><%= subCategory.categoryDetail?.name || 'N/A' %></td>
                  <td><%= subCategory.userDetail?.fName + " " + subCategory.userDetail?.lName || 'N/A' %></td>
                  <td><span class="tag tag-success"><%= subCategory.userDetail?.email || 'N/A' %></span></td>
                  <td>
                    <!-- Edit Button -->
                    <a href="/admin/update/<%= subCategory.userDetail.id %>" class="btn btn-primary btn-sm">Edit</a>

                    <!-- Delete Button -->
                    <button
                      class="btn btn-danger btn-sm"
                      data-toggle="modal"
                      data-target="#deleteModal"
                      data-userid="<%= subCategory.userDetail.id %>"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
                <% }) %> <% } else { %>
                <tr>
                  <td colspan="6">No sub-categories found</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Pagination -->
    <nav aria-label="Page navigation">
      <ul class="pagination justify-content-center">
        <!-- Show previous page link -->
        <% if (currentPage > 1) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
        </li>
        <% } %>

        <!-- Page numbers -->
        <% for (let i = 1; i <= totalPage; i++) { %>
        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
        <% } %>

        <!-- Show next page link -->
        <% if (currentPage < totalPage) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
        </li>
        <% } %>
      </ul>
    </nav>
  </div>
</section>

<%- include('../../layout/footer') %>
